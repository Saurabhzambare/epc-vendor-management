@model IEnumerable<EpcVendorManagement.Web.Models.Entities.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Departments</h1>
        <p class="text-muted">
            View the departments used across EPC projects.
        </p>
    </div>
</div>

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success">
        @message
    </div>
}

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        New department
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No departments yet.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var department in Model)
            {
                <tr>
                    <td>@department.Name</td>

                    <td>
                        @(string.IsNullOrWhiteSpace(department.Description)
                            ? "—"
                            : department.Description)
                    </td>

                    <td>
                        @(department.IsActive ? "Active" : "Inactive")
                    </td>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@department.Id"
                           class="btn btn-sm btn-outline-primary">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@department.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Edit
                        </a>

                        @if (department.IsActive)
                        {
                            <form asp-action="Deactivate"
                                  asp-route-id="@department.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to deactivate this department?');">

                                <button type="submit"
                                        class="btn btn-sm btn-danger">
                                    Deactivate
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted ms-1">
                                Already inactive
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}